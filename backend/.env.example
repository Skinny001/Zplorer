# GetBlock Zcash RPC URL (get yours at https://getblock.io)
# Format: https://<region>.getblock.io/<YOUR_API_KEY>
RPC_URL=https://shared.eu-central-1.getblock.io/YOUR_API_KEY_HERE

# Backend port
PORT=3001

# RPC timeout in ms (default 30000)
RPC_TIMEOUT=30000

# Optional: if your RPC requires basic auth
# RPC_USER=
# RPC_PASS=